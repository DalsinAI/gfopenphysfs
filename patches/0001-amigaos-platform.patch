@@ -225,7 +225,7 @@
 
 #if defined(PHYSFS_DECL)
 /* do nothing. */
-#elif defined(PHYSFS_STATIC)
+#elif defined(PHYSFS_STATIC) || defined(__amigaos__) /* AmiCradle: a static library */
 #define PHYSFS_DECL   /**/
